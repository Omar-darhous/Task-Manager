# ==============================================================================
# Task Manager Backend Environment Configuration Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit real credentials or .env files to version control!
# ==============================================================================

# Server Port
PORT=5000

# Application Environment: development | production | test
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local instance)
# In production, MONGODB_URI is required.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/task_manager?retryWrites=true&w=majority

# Client Application URL (Allowed CORS Origin)
# In production, must match your deployed frontend URL (e.g. https://tasks.example.com).
# Multiple origins can be separated by commas.
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
# Must be at least 32 characters in production (e.g. generated via `openssl rand -hex 32`).
# In development, minimum 10 characters.
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_dev

# JWT Token Expiration (e.g. 1d, 7d, 30d)
JWT_EXPIRES_IN=1d
