# ==============================================================================
# Task Manager Frontend Environment Configuration Template
# Copy this file to .env and set your API base URL.
# NOTE: Variables prefixed with VITE_ are embedded into client bundle.
# NEVER put private server secrets (e.g. JWT_SECRET, MONGODB_URI) in this file!
# ==============================================================================

# Backend API Base URL (must include /api path)
# Development default: http://localhost:5000/api
# Production example: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5000/api
